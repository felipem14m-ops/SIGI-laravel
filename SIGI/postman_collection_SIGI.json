								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"nombre\": \"Cajero Móvil\",\n    \"numeroIdentificacion\": \"1085293847\",\n    \"email\": \"cajero@sigi.com\",\n    \"password\": \"12345678\",\n    \"id_rol\": 2\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/register",
							"host": ["{{baseUrl}}"],
							"path": ["register"]
