{
	"info": {
		"_postman_id": "sigi-api-collection-v1",
		"name": "SIGI API - Mobile & POS",
		"description": "Colección completa de endpoints para la aplicación móvil en Flutter y pruebas en Postman del Sistema SIGI.",
